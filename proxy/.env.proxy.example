# Salin menjadi proxy/.env.proxy bila perlu. Semua baris opsional.

# Alamat project Supabase. Kalau kosong, dibaca dari VITE_SUPABASE_URL di file .env project.
# SUPABASE_URL=https://xxxxxxxx.supabase.co

# Port server (default 8080).
# PORT=8080

# Alamat yang dipakai komputer lain untuk membuka aplikasi. Kalau kosong, otomatis dari
# alamat yang diketik di browser (mis. http://192.168.1.10:8080). Isi hanya bila server
# berada di belakang proxy/HTTPS lain, mis. https://wo.perusahaan.local
# PUBLIC_ORIGIN=

# Folder hasil build offline (default: dist-offline di root project).
# DIST_DIR=../dist-offline

# 1 = catat setiap permintaan ke log.
# LOG_REQUESTS=0
